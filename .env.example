# sunscraping — Environment Configuration
# Copy this file to .env and modify as needed.
# Note: the backend does not load .env automatically; export these variables
# in your shell or use START_launcher.bat / START_sunscraping.bat.

# Override the API key for mutating endpoints.
# Leave empty to let the backend generate one in backend/.api_key
# (shown in the Launcher and used to pair the Chrome extension).
SA_API_KEY=

# Server port (server binds to 127.0.0.1 only). The CORS allowlist is derived
# from this value, and chrome-extension/config.js must use the same port.
SA_PORT=5000

# Local launcher port (binds to 127.0.0.1; falls forward when busy).
SA_LAUNCHER_PORT=5050

# SQLite database location (default: backend/sunscraping.db)
# SA_DB_PATH=

# Debug mode (set to 'true' for development only!)
FLASK_DEBUG=false
