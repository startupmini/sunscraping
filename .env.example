# sunscraping — Environment Configuration
# Copy this file to .env and modify as needed.
# Note: the backend does not load .env automatically; export these variables
# in your shell or use run_hidden.bat / START_SocialAuditor.bat.

# Override the API key for mutating endpoints.
# Leave empty to let the backend generate one in backend/.api_key
# (shown in the Control Panel and used to pair the Chrome extension).
SA_API_KEY=

# Server port (server binds to 127.0.0.1 only)
SA_PORT=5000

# SQLite database location (default: backend/social_auditor.db)
# SA_DB_PATH=

# Debug mode (set to 'true' for development only!)
FLASK_DEBUG=false
