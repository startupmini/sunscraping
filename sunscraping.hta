<!DOCTYPE html>
<html>
<head>
    <title>sunscraping Control</title>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <HTA:APPLICATION
        ID="sunscrapingLauncher"
        APPLICATIONNAME="sunscraping"
        BORDER="dialog"
        INNERBORDER="no"
        CAPTION="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        SCROLL="no" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: #f5f6f8;
            color: #172033;
            padding: 18px;
            -webkit-font-smoothing: antialiased;
        }

        h1, p { margin: 0; }

        .shell {
            background: #ffffff;
            border: 1px solid #e6e8ec;
            border-radius: 16px;
            padding: 18px;
        }

        /* ---------- Header ---------- */
        .app-header {
            display: -ms-flexbox;
            display: flex;
            -ms-flex-align: center;
            align-items: center;
            margin-bottom: 16px;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border: 0;
            margin-right: 11px;
        }

        .brand-copy .brand-tail {
            color: #475467;
        }

        .brand-copy {
            -ms-flex: 1;
            flex: 1;
        }

        .brand-copy h1 {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: #0b1220;
        }

        .brand-copy p {
            font-size: 11px;
            color: #667085;
        }

        .version {
            padding: 3px 7px;
            border: 1px solid #e6e8ec;
            border-radius: 6px;
            background: #f9fafb;
            color: #98a2b3;
            font-size: 10px;
        }

        /* ---------- Status card ---------- */
        .status-card {
            border: 1px solid #e6e8ec;
            border-radius: 13px;
            background: #f9fafb;
            padding: 14px;
            margin-bottom: 14px;
        }

        .status-head {
            display: -ms-flexbox;
            display: flex;
            -ms-flex-align: center;
            align-items: center;
            -ms-flex-pack: justify;
            justify-content: space-between;
            padding-bottom: 11px;
            margin-bottom: 10px;
            border-bottom: 1px solid #e6e8ec;
        }

        .status-caption {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #667085;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 9px;
            border: 1px solid #e6e8ec;
            border-radius: 20px;
            background: #ffffff;
            font-size: 11px;
            font-weight: 600;
        }

        .status-value {
            font-family: Consolas, 'Courier New', monospace;
            font-size: 11px;
            font-weight: 700;
            color: #667085;
        }

        .status-value.online { color: #067647; }
        .status-value.offline { color: #b42318; }
        .status-value.starting { color: #b54708; }

        .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 6px;
            vertical-align: middle;
            background: #98a2b3;
        }

        .dot.green { background: #067647; }
        .dot.red { background: #b42318; }
        .dot.yellow { background: #b54708; }

        .meta-row {
            display: -ms-flexbox;
            display: flex;
            -ms-flex-align: center;
            align-items: center;
            -ms-flex-pack: justify;
            justify-content: space-between;
            margin-bottom: 7px;
            font-size: 11.5px;
        }

        .meta-row.last { margin-bottom: 0; }

        .meta-label {
            color: #667085;
        }

        .meta-value {
            font-family: Consolas, 'Courier New', monospace;
            font-size: 11px;
            color: #172033;
            font-weight: 600;
        }

        .key-wrap {
            display: -ms-flexbox;
            display: flex;
            -ms-flex-align: center;
            align-items: center;
        }

        .btn-copy {
            margin-left: 7px;
            padding: 3px 8px;
            border: 1px solid #d5d9e0;
            border-radius: 6px;
            background: #ffffff;
            color: #344054;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-copy:hover { background: #f2f4f7; }
        .btn-copy:disabled { color: #c0c6d0; cursor: default; }

        /* ---------- Buttons ---------- */
        .btn {
            display: block;
            width: 100%;
            padding: 11px;
            border: 1px solid transparent;
            border-radius: 10px;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            font-size: 12.5px;
            font-weight: 600;
            cursor: pointer;
            box-sizing: border-box;
        }

        .btn-start {
            background: #0b1220;
            color: #ffffff;
            margin-bottom: 9px;
        }

        .btn-start:hover { background: #1b2740; }
        .btn-start:disabled { background: #98a2b3; cursor: default; }

        .btn-row {
            display: -ms-flexbox;
            display: flex;
            margin-bottom: 16px;
        }

        .btn-row .btn {
            -ms-flex: 1;
            flex: 1;
        }

        .btn-row .btn:first-child { margin-right: 9px; }

        .btn-secondary {
            border-color: #d5d9e0;
            background: #ffffff;
            color: #344054;
        }

        .btn-secondary:hover { background: #f2f4f7; }
        .btn-secondary:disabled {
            border-color: #e6e8ec;
            background: #ffffff;
            color: #98a2b3;
            cursor: default;
        }

        .note {
            margin-top: 8px;
            color: #98a2b3;
            font-size: 10px;
            line-height: 1.5;
            text-align: center;
        }

        .btn-stop {
            border-color: #fecdca;
            background: #fef3f2;
            color: #b42318;
        }

        .btn-stop:hover { background: #fee4e2; }
        .btn-stop:disabled {
            border-color: #e6e8ec;
            background: #ffffff;
            color: #98a2b3;
            cursor: default;
        }

        /* ---------- Stats ---------- */
        .stats {
            display: -ms-flexbox;
            display: flex;
            padding-top: 14px;
            border-top: 1px solid #e6e8ec;
        }

        .stat {
            -ms-flex: 1;
            flex: 1;
            text-align: center;
            border-right: 1px solid #e6e8ec;
        }

        .stat.last { border-right: 0; }

        .stat .num {
            display: block;
            font-size: 17px;
            font-weight: 700;
            color: #172033;
            line-height: 1.2;
        }

        .stat .lbl {
            font-size: 9px;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            color: #98a2b3;
        }

        .stat.pending .num { color: #667085; }
        .stat.running .num { color: #1d4ed8; }
        .stat.ok .num { color: #067647; }
        .stat.fail .num { color: #b42318; }

        .foot {
            margin-top: 14px;
            text-align: center;
            font-size: 10px;
            color: #98a2b3;
        }
    </style>
    <script language="JScript">
        window.resizeTo(420, 620);
        window.moveTo((screen.availWidth - 420) / 2, (screen.availHeight - 620) / 2);

        var DEFAULT_PORT = 5000;
        var serverPort = DEFAULT_PORT;
        var healthTimer = null;
        var serverPID = null;
        var wasOnline = false;
        var pendingDashboardOpen = false;
        var currentApiKey = null;

        function resolvePort() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var raw = shell.ExpandEnvironmentStrings("%SA_PORT%");
                if (raw && raw != "%SA_PORT%" && /^\d{1,5}$/.test(raw)) {
                    var port = parseInt(raw, 10);
                    if (port > 0 && port < 65536) return port;
                }
            } catch(e) {}
            return DEFAULT_PORT;
        }

        function serverUrl(path) {
            return "http://localhost:" + serverPort + path;
        }

        function getHtaDir() {
            var htaPath = document.location.pathname;
            try { htaPath = decodeURIComponent(htaPath); } catch(e) {}
            if (htaPath.charAt(0) == '/') htaPath = htaPath.substring(1);
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.GetParentFolderName(htaPath);
        }

        function loadApiKey() {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                var keyFile = getHtaDir() + "\\backend\\.api_key";
                if (!fso.FileExists(keyFile)) { setApiKey(null); return; }
                var ts = fso.OpenTextFile(keyFile, 1);
                var key = ts.ReadAll().replace(/^\s+|\s+$/g, '');
                ts.Close();
                setApiKey(key);
            } catch(e) {
                setApiKey(null);
            }
        }

        function setApiKey(key) {
            currentApiKey = key || null;
            var el = document.getElementById("apiKeyValue");
            var btn = document.getElementById("btnCopyKey");
            if (currentApiKey) {
                el.innerText = currentApiKey.length > 8
                    ? currentApiKey.substring(0, 4) + "..." + currentApiKey.substring(currentApiKey.length - 4)
                    : "••••••••";
                btn.disabled = false;
            } else {
                el.innerText = "-";
                btn.disabled = true;
            }
        }

        function copyApiKey() {
            if (!currentApiKey) return;
            try {
                window.clipboardData.setData("Text", currentApiKey);
                var btn = document.getElementById("btnCopyKey");
                btn.innerText = "Tersalin";
                setTimeout(function() { btn.innerText = "Salin"; }, 1500);
            } catch(e) {
                alert("Clipboard tidak tersedia. Buka file backend\\.api_key dengan Notepad untuk menyalin key secara manual.");
            }
        }

        function startServer() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                // First, stop any existing server
                stopServerSilent();

                var htaDir = getHtaDir();
                shell.CurrentDirectory = htaDir;
                shell.Run('cmd.exe /c "' + htaDir + '\\run_hidden.bat"', 0, false);

                setStatus("starting", "Memulai...", "-");
                document.getElementById("btnStart").disabled = true;
                document.getElementById("btnDashboard").disabled = true;
                pendingDashboardOpen = true;

                // Start health polling — dashboard opens on first healthy response
                startHealthPolling();
            } catch(e) {
                alert("Gagal memulai server: " + e.message);
            }
        }

        function openDashboard() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run(serverUrl("/"));
            } catch(e) {}
        }

        function stopServer() {
            if (!confirm("Hentikan server sunscraping?")) return;
            pendingDashboardOpen = false;
            stopServerSilent();
            // handleOffline() menyelaraskan tombol; polling sudah dimatikan, jadi
            // status harus ditulis ulang agar tidak kembali berbunyi "Nonaktif".
            handleOffline();
            setStatus("offline", "Dihentikan", "-");
            serverPID = null;
        }

        function stopServerSilent() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                var htaDir = getHtaDir();
                var pidFile = htaDir + "\\backend\\server.pid";
                
                if (fso.FileExists(pidFile)) {
                    // Read PID from file and kill only that specific process
                    var ts = fso.OpenTextFile(pidFile, 1);
                    var pid = ts.ReadAll().replace(/\s/g, '');
                    ts.Close();
                    
                    if (/^\d{1,10}$/.test(pid)) {
                        shell.Run("taskkill /PID " + pid + " /F /T", 0, true);
                    }
                    
                    // Clean up PID file
                    try { fso.DeleteFile(pidFile); } catch(e) {}
                } else {
                    // Fallback: match the absolute app.py path this launcher starts.
                    // run_hidden.bat invokes python with the full path, so the command line is matchable.
                    // Single quotes only — nested \" quoting is unreliable through shell.Run.
                    var appPy = htaDir + "\\backend\\app.py";
                    var cmd = 'powershell -windowstyle hidden -Command "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq \'python.exe\' -and $_.CommandLine -like \'*' + appPy + '*\' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"';
                    shell.Run(cmd, 0, true);
                }
            } catch(e) {}
            
            if (healthTimer) { clearInterval(healthTimer); healthTimer = null; }
        }

        function startHealthPolling() {
            if (healthTimer) clearInterval(healthTimer);
            healthTimer = setInterval(checkHealth, 5000);
            // First check immediately
            setTimeout(checkHealth, 1500);
        }

        function checkHealth() {
            try {
                var xhr = new ActiveXObject("MSXML2.XMLHTTP");
                xhr.open("GET", serverUrl("/api/health"), true); // TRUE = Asynchronous (non-blocking)
                xhr.setRequestHeader("Accept", "application/json");
                
                xhr.onreadystatechange = function() {
                    if (xhr.readyState == 4) {
                        if (xhr.status == 200) {
                            try {
                                var data = JSON.parse(xhr.responseText);
                                serverPID = data.pid;
                                setStatus("online", "Aktif", "PID " + data.pid);
                                document.getElementById("btnStart").disabled = true;
                                document.getElementById("btnStop").disabled = false;
                                var dashBtn = document.getElementById("btnDashboard");
                                dashBtn.disabled = false;
                                dashBtn.title = "Buka dashboard sunscraping";
                                
                                // Update task stats
                                var t = data.tasks || {};
                                updateTaskStats(t.PENDING || 0, t.RUNNING || 0, t.OK || 0, t.FAILED || 0);

                                if (!wasOnline) {
                                    wasOnline = true;
                                    loadApiKey();
                                    if (pendingDashboardOpen) {
                                        pendingDashboardOpen = false;
                                        openDashboard();
                                    }
                                }
                            } catch(e) {
                                handleOffline();
                            }
                        } else {
                            handleOffline();
                        }
                    }
                };
                xhr.send();
            } catch(e) {
                handleOffline();
            }
        }

        function handleOffline() {
            wasOnline = false;
            setStatus("offline", "Nonaktif", "-");
            document.getElementById("btnStart").disabled = false;
            document.getElementById("btnStop").disabled = true;
            var dashBtn = document.getElementById("btnDashboard");
            dashBtn.disabled = true;
            dashBtn.title = "Server belum aktif";
            updateTaskStats(0, 0, 0, 0);
        }

        function setStatus(state, label, pid) {
            var dotClass = state == "online" ? "green" : state == "starting" ? "yellow" : "red";
            document.getElementById("statusDot").className = "dot " + dotClass;
            document.getElementById("statusLabel").className = "status-value " + state;
            document.getElementById("statusLabel").innerText = label;
            document.getElementById("pidValue").innerText = pid;
        }

        function updateTaskStats(pending, running, ok, failed) {
            document.getElementById("statPending").innerText = pending;
            document.getElementById("statRunning").innerText = running;
            document.getElementById("statOk").innerText = ok;
            document.getElementById("statFailed").innerText = failed;
        }

        // Auto-check on launch
        function onLoad() {
            serverPort = resolvePort();
            var endpointEl = document.getElementById("endpointValue");
            if (endpointEl) endpointEl.innerText = "localhost:" + serverPort;
            var footEl = document.getElementById("footEndpoint");
            if (footEl) footEl.innerText = "Hanya 127.0.0.1 · port " + serverPort;
            document.getElementById("btnDashboard").disabled = true;

            loadApiKey();
            checkHealth();
            startHealthPolling();
        }
    </script>
</head>
<body onload="onLoad()">
    <div class="shell">
        <header class="app-header">
            <img class="brand-mark" src="chrome-extension/icons/icon48.png" width="38" height="38" alt="">
            <div class="brand-copy">
                <h1>sun<span class="brand-tail">scraping</span></h1>
                <p>Control Panel</p>
            </div>
            <span class="version">v3.5</span>
        </header>

        <section class="status-card">
            <div class="status-head">
                <span class="status-caption">Status server</span>
                <span class="status-badge">
                    <span id="statusDot" class="dot red"></span>
                    <span id="statusLabel" class="status-value offline">Memeriksa...</span>
                </span>
            </div>

            <div class="meta-row">
                <span class="meta-label">Proses</span>
                <span id="pidValue" class="meta-value">-</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">Endpoint</span>
                <span id="endpointValue" class="meta-value">localhost:5000</span>
            </div>
            <div class="meta-row last">
                <span class="meta-label">API key</span>
                <span class="key-wrap">
                    <span id="apiKeyValue" class="meta-value" title="Hanya sebagian karakter yang ditampilkan">-</span>
                    <button id="btnCopyKey" class="btn-copy" onclick="copyApiKey()" title="Salin API key lengkap ke clipboard" disabled>Salin</button>
                </span>
            </div>
        </section>

        <p class="note">API key lengkap tidak pernah ditampilkan. Gunakan tombol Salin.</p>

        <button id="btnStart" class="btn btn-start" onclick="startServer()">Mulai server</button>

        <div class="btn-row">
            <button id="btnDashboard" class="btn btn-secondary" onclick="openDashboard()" title="Server belum aktif" disabled>Buka dashboard</button>
            <button id="btnStop" class="btn btn-stop" onclick="stopServer()" disabled>Hentikan</button>
        </div>

        <div class="stats">
            <div class="stat pending">
                <span id="statPending" class="num">0</span>
                <span class="lbl">Antrean</span>
            </div>
            <div class="stat running">
                <span id="statRunning" class="num">0</span>
                <span class="lbl">Berjalan</span>
            </div>
            <div class="stat ok">
                <span id="statOk" class="num">0</span>
                <span class="lbl">Selesai</span>
            </div>
            <div class="stat fail last">
                <span id="statFailed" class="num">0</span>
                <span class="lbl">Gagal</span>
            </div>
        </div>

        <p id="footEndpoint" class="foot">Berjalan lokal · 127.0.0.1</p>
    </div>
</body>
</html>
